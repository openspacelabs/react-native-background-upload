{
  "compilerOptions": {
    "baseUrl": "src",
    "module": "esnext",
    "target": "es6",
    "lib": ["es6", "dom", "es2016", "es2017"],
    "jsx": "react",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noEmit": true
  },
  "exclude": ["example", "src/__tests__"]
}
